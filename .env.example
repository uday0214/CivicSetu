# CivicSetu Environment Configuration

# Google AI Studio Gemini API Key (Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Pinned Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter Automated Fallback API (Optional, triggers when Gemini fails/rate-limits)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Storage Mode: "memory" (local development) or "firestore" (GCP production)
DATA_STORE_MODE=memory

# Server Port
PORT=8000

# Google Cloud Project & Bucket (required only when DATA_STORE_MODE=firestore)
GOOGLE_CLOUD_PROJECT=civicsetu-demo
GCS_BUCKET=civicsetu-media-us-central1

# Demo Circuit Breaker: fallback to deterministic schema-valid JSON on 429 quota exhaustion (set true for live demos)
DEMO_FALLBACK_ON_QUOTA=false
